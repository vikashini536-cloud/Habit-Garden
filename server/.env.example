# Copy this file to server/.env and fill in real values.
# server/.env is listed in .gitignore and must never be committed.

NODE_ENV=development
PORT=3001

# The browser address the app is served from.
# Development: Vite runs here. Production: your real https domain.
APP_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=habit_garden_app
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=habit_garden

# How long a login lasts before the user must log in again.
SESSION_TTL_DAYS=14
